#!/bin/sh
[ -n "${ZSH_VERSION:-}" ] && emulate sh

disk_self="$0"
case "${disk_self}" in
  */*) ;;
  *) disk_self="$(command -v -- "${disk_self}")" ;;
esac
DISK_LIB="$(cd "${disk_self%/*}/../lib" && pwd)" || exit 1

DISK_PROG=kiyome
# shellcheck source=SCRIPTDIR/../lib/core.sh
. "${DISK_LIB}/core.sh"
# shellcheck source=SCRIPTDIR/../lib/cli.sh
. "${DISK_LIB}/cli.sh"
# shellcheck source=SCRIPTDIR/../lib/ui.sh
. "${DISK_LIB}/ui.sh"
# shellcheck source=SCRIPTDIR/../lib/io.sh
. "${DISK_LIB}/io.sh"
# shellcheck source=SCRIPTDIR/../lib/calibrate.sh
. "${DISK_LIB}/calibrate.sh"
# shellcheck source=SCRIPTDIR/../lib/wipe.sh
. "${DISK_LIB}/wipe.sh"
# shellcheck source=SCRIPTDIR/../lib/boot.sh
. "${DISK_LIB}/boot.sh"

disk_wipe_usage() {
  cat <<'USAGE'
kiyome - overwrite a disk with five verified patterns, reporting any bad bit line

usage:
  kiyome                              ask for the disk and the number of passes
  kiyome [options] <device|mount_point>
                                      wipe that disk
  kiyome doctor                       check the tools kiyome needs
  kiyome version                      print the version
  kiyome help                         print this page

options:
  --passes N          repeat the five patterns N times (default 1)
  --create            leave a fresh FAT or exFAT filesystem behind
  --allow-internal    allow an internal disk. the system disk is always refused

environment:
  PASSES=N, CREATE=y and ALLOW_INTERNAL=y set the same options. an option on
  the command line wins.

notes:
  Each pass writes per-chunk unique AES-CTR data, then 0xAA, 0x55, 0xFF and
  0x00, and reads every one back. A wrong byte is reported with the bit lines
  involved, which tells a stuck data line apart from worn media.

examples:
  kiyome /dev/disk4
  kiyome /Volumes/USB
  kiyome --passes 3 /dev/sdb
  kiyome --create /dev/disk4
USAGE
}

disk_option_flag() {
  case "$1" in
    --create) CREATE=y ;;
    --allow-internal) ALLOW_INTERNAL=y ;;
    *) return 1 ;;
  esac
  return 0
}

disk_option_value() {
  PASSES="$2"
  return 0
}

disk_wipe_ask() {
  disk_wk_disk="$(disk_pick_single "Wipe which disk? Number or name: ")" || return 1
  if [ -z "${PASSES:-}" ]; then
    PASSES="$(disk_prompt "Passes" 1)" || return 1
  fi
  disk_wipe_run "${disk_wk_disk}"
}

disk_wipe_check_passes() {
  if ! disk_is_uint "$1" || [ "$1" -lt 1 ]; then
    disk_error "--passes must be a whole number of 1 or more, got: $1"
    return 1
  fi
  return 0
}

disk_wipe_validate() {
  if [ ! -b "$1" ] && [ ! -c "$1" ]; then
    disk_error "device not found or invalid: $1."
    return 1
  fi
  if ! disk_cmd_exists openssl; then
    disk_error "openssl is required to build the per-chunk unique pattern."
    return 1
  fi
  return 0
}

disk_wipe_identify() {
  DISK_IDENTITY="$(disk_identity "$1")"
  DISK_FAMILY="$(disk_family_of "${DISK_IDENTITY}")"
  return 0
}

disk_wipe_plan() {
  disk_wpl_noun="passes"
  [ "$1" -eq 1 ] && disk_wpl_noun="pass"
  disk_info "Plan:   $1 ${disk_wpl_noun} of unique data, 0xAA, 0x55, 0xFF and 0x00, each read back"
  if [ "${CREATE:-}" = "y" ]; then
    disk_info "        then a fresh FAT or exFAT filesystem, then eject"
  else
    disk_info "        then eject"
  fi
}

disk_wipe_summary() {
  printf '\n'
  disk_ws_human="$(disk_human "${DISK_SIZE}")"
  disk_info "Device: $1, ${disk_ws_human}, ${DISK_IDENTITY:-unnamed device}"
  [ -n "${DISK_FAMILY}" ] && disk_info "        ${DISK_FAMILY} media, which only sets the volume label"
  disk_ws_parts="$(disk_partitions_text "$1")"
  if [ -n "${disk_ws_parts}" ]; then
    disk_info "        Everything on it is erased, including:"
    printf '%s\n' "${disk_ws_parts}"
  fi
  disk_wipe_plan "$2"
  printf '\n'
}

disk_wipe_size() {
  DISK_SIZE="$(disk_size_bytes "$1")"
  if ! disk_is_uint "${DISK_SIZE}" || [ "${DISK_SIZE}" -eq 0 ]; then
    disk_error "unable to determine disk size for $1."
    return 1
  fi
  DISK_SECTOR="$(disk_sector_bytes "$1")"
  if [ $((DISK_SIZE % DISK_SECTOR)) -ne 0 ]; then
    disk_warning "device size is not a whole number of sectors. skipping the last $((DISK_SIZE % DISK_SECTOR)) bytes."
    DISK_SIZE=$((DISK_SIZE - DISK_SIZE % DISK_SECTOR))
  fi
  disk_set_ceiling "${DISK_SIZE}"
  return 0
}

disk_wipe_landing() {
  disk_wl_status=0
  disk_writes_land "$1" || disk_wl_status="$?"
  if [ "${disk_wl_status}" -eq 1 ]; then
    disk_report_write_protected "$1" silent erased
    return 1
  fi
  disk_wl_detail="$(disk_get_error)"
  disk_wl_class="$(disk_error_class "${disk_wl_detail}")"
  if [ "${disk_wl_status}" -eq 2 ] && [ "${disk_wl_class}" = "bus" ]; then
    disk_fault "$1" "$1 stopped answering during the single-sector write test."
    return 1
  fi
  return 0
}

disk_wipe_passes() {
  disk_wp_index=1
  while [ "${disk_wp_index}" -le "$3" ]; do
    disk_execute_pass "$1" "$2" "${disk_wp_index}" "$3" || return 1
    disk_wp_index=$((disk_wp_index + 1))
  done
  disk_success "Wiped $1: every byte of every pattern read back as written."
  return 0
}

disk_wipe_eject() {
  disk_info "Ejecting $1..."
  case "${DISK_FAMILY}" in
    floppy | superdisk)
      if disk_release "$1" >/dev/null 2>&1; then
        disk_success "Done. This drive has no software eject, so take the disk out now."
      else
        disk_warning "$1 is still mounted. remove the disk by hand once it is idle."
      fi
      ;;
    *)
      sync
      if disk_bounded 30 sudo diskutil eject "$1" >/dev/null 2>&1 || disk_bounded 30 sudo eject "$1" >/dev/null 2>&1; then
        disk_success "Ejected. $1 is safe to remove."
      else
        disk_warning "$1 did not eject. the wipe already finished, so remove it once the light stops."
      fi
      ;;
  esac
  return 0
}

disk_wipe_prepare() {
  disk_wipe_validate "$1" || return 1
  disk_wipe_identify "$1"
  disk_wipe_size "$1" || return 1
  disk_wipe_summary "$1" "$2"
  disk_confirm_names "$1" erase || return 1
  disk_tune
  disk_wpr_writable=0
  disk_writable_media "$1" || disk_wpr_writable="$?"
  if [ "${disk_wpr_writable}" -eq 1 ]; then
    disk_report_write_protected "$1" flag erased
    return 1
  fi
  disk_require_sudo || return 1
  disk_unmount_for_write "$1" || return 1
  disk_wpr_io="$(disk_io_device "$1")"
  disk_probe_cache_bypass "${disk_wpr_io}" "${DISK_SECTOR}"
  return 0
}

disk_wipe_main() {
  case "${1:-}" in
    help | -h | --help) disk_wipe_usage ;;
    version | -V | --version) disk_cli_version ;;
    doctor) disk_doctor ;;
    *) disk_wipe_parse "$@" ;;
  esac
}

disk_wipe_parse() {
  DISK_VALUE_OPTIONS="--passes"
  disk_wa_left="$#"
  disk_wa_literal=0
  while [ "${disk_wa_left}" -gt 0 ]; do
    disk_wa_arg="$1"
    shift
    disk_wa_left=$((disk_wa_left - 1))
    if [ "${disk_wa_literal}" -eq 1 ] || ! disk_cli_is_option "${disk_wa_arg}"; then
      set -- "$@" "${disk_wa_arg}"
    elif [ "${disk_wa_arg}" = "--" ]; then
      disk_wa_literal=1
    else
      disk_cli_option "${disk_wa_arg}" "${disk_wa_left}" "${1:-}" || return 1
      if [ "${DISK_CLI_USED}" -eq 1 ]; then
        shift
        disk_wa_left=$((disk_wa_left - 1))
      fi
    fi
  done
  disk_wipe_start "$@"
}

disk_wipe_start() {
  if [ "$#" -gt 1 ]; then
    disk_cli_hint "unexpected extra argument '$2'"
    return 1
  fi
  if [ "$#" -eq 1 ]; then
    disk_wipe_run "$1"
    return "$?"
  fi
  if disk_cli_interactive; then
    disk_wipe_ask
    return "$?"
  fi
  disk_cli_hint "no disk given"
  return 1
}

disk_wipe_run() {
  disk_wipe_check_passes "${PASSES:-1}" || return 1
  disk_wm_disk="$(disk_resolve "$1")" || return 1
  disk_refuse_target "${disk_wm_disk}" || return 1
  DISK_ERRFILE=""
  DISK_LAST_ERROR=""
  DISK_LAST_DETAIL=""
  DISK_FAMILY=""
  DISK_ACTION_NOUN="wipe"
  disk_wm_passes="${PASSES:-1}"

  disk_wipe_prepare "${disk_wm_disk}" "${disk_wm_passes}" || return 1
  disk_make_tmpdir kiyome || return 1
  disk_reset_measurements
  disk_wm_status=0
  disk_wipe_landing "${disk_wm_disk}" || disk_wm_status=1
  if [ "${disk_wm_status}" -eq 0 ]; then
    disk_measure "${disk_wm_disk}" "${DISK_SIZE}" wiping "the wipe" || disk_wm_status=1
  fi
  if [ "${disk_wm_status}" -eq 0 ]; then
    disk_wipe_passes "${disk_wm_disk}" "${DISK_SIZE}" "${disk_wm_passes}" || disk_wm_status=1
  fi
  disk_drop_tmpdir
  [ "${disk_wm_status}" -ne 0 ] && return 1

  if [ "${CREATE:-}" = "y" ] && ! disk_create_partition "${disk_wm_disk}" "${DISK_SIZE}"; then
    return 1
  fi
  disk_wipe_eject "${disk_wm_disk}"
}

disk_wipe_main "$@"
